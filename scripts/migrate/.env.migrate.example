# ===== Supabase → Coolify/Hetzner migration =====
# Copy to  site/.env.migrate  (git-ignored). NEVER commit real values.

# --- SOURCE: Supabase (read-only use by these scripts) ---
# Dashboard → Project Settings → Database → Connection string.
# Use the DIRECT / Session connection on port 5432 (NOT the transaction pooler 6543):
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- TARGET: new Postgres on Coolify (superuser/owner URL, used ONLY for restore) ---
NEW_DB_URL=postgresql://postgres:[password]@[hetzner-host]:[port]/kinaiauto?sslmode=require

# App roles the restore creates (choose strong random passwords):
RO_PASSWORD=
RW_PASSWORD=

# --- TARGET: object storage — MinIO on Coolify (any S3-compatible works) ---
# Use the MinIO *API* URL that Coolify exposes for S3 traffic — NOT the console URL.
S3_ENDPOINT=https://minio-api.your-domain.tld
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
