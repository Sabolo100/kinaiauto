# ===== kinaiauto.com — environment =====

# ---- Public site (browser-exposed) ----
NEXT_PUBLIC_SITE_URL=https://www.kinaiauto.com
# Public base URL of the media buckets (path-style S3 endpoint). Object URL =
# ${NEXT_PUBLIC_S3_PUBLIC_BASE}/<bucket>/<storage_path>
NEXT_PUBLIC_S3_PUBLIC_BASE=https://minio-api.your-domain.tld

# Google Analytics 4 — Measurement ID (stream: kinaiauto 1)
NEXT_PUBLIC_GA_ID=G-EJ796KPPTX

# ---- Server-only (NEVER prefix with NEXT_PUBLIC_) ----

# Postgres on Coolify/Hetzner. Two roles mirror the old anon / service-role split:
#   kinaiauto_rw — CMS + public writes (quote requests, analytics events)
#   kinaiauto_ro — public site reads (SELECT on public tables + views only)
DATABASE_URL=postgresql://kinaiauto_rw:PASSWORD@your-hetzner-host:5432/kinaiauto
DATABASE_URL_RO=postgresql://kinaiauto_ro:PASSWORD@your-hetzner-host:5432/kinaiauto
# require (default, encrypts in transit) | prefer | verify-full | false
DATABASE_SSL=require
DATABASE_POOL_MAX=3

# Object storage — MinIO on Coolify (any S3-compatible works). Use the MinIO API URL.
# Buckets: car-photos, brand-logos (public-read), pdf-uploads (private).
S3_ENDPOINT=https://minio-api.your-domain.tld
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# CMS admin gate (path: /c4m5s6).
# CMS_PASSWORD: shared secret typed into the login form.
# CMS_SESSION_SECRET: 32+ char random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CMS_PASSWORD=change-me
CMS_SESSION_SECRET=replace-with-random-hex-string

# ---- Optional: LLM providers for the CMS extract feature ----
# Set at least ONE. The CMS will only show enabled providers in the dropdown.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Optional: web search / research (CMS test-link + new-model discovery) ----
# Perplexity — preferred engine for "Új modellek keresése". Get a key at:
#   https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# Serper.dev (Google Search) + YouTube Data API — used by test-link search and
# as the fallback for new-model discovery (needs ANTHROPIC_API_KEY too).
SERPER_API_KEY=
YOUTUBE_API_KEY=
